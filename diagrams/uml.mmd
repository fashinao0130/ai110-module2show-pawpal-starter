classDiagram
    %% Keep this file updated so it matches your final implementation.

    class Owner {
        +str name
        +list~Pet~ pets
        +add_pet(pet) None
        +get_pets() list~Pet~
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +str breed
        +list~Task~ tasks
        +add_task(task) None
        +get_tasks() list~Task~
        +mark_task_complete(task) Task
    }

    class TaskCategory {
        <<enumeration>>
        FEEDING
        WALK
        MEDICATION
        APPOINTMENT
    }

    class Task {
        +str description
        +TaskCategory category
        +date date
        +str scheduled_time
        +int duration_minutes
        +str priority
        +str frequency
        +bool is_completed
        +mark_complete() Task
        +next_occurrence() Task
        +is_due_on(target_date) bool
    }

    class Scheduler {
        +get_tasks_for_today(owner, today) list~Task~
        +get_tasks_for_pet(pet, today) list~Task~
        +sort_by_time(tasks) list~Task~
        +build_daily_plan(owner, today) list~Task~
        +find_conflicts(owner, today) list~str~
    }

    Owner "1" --> "*" Pet : owns
    Pet "1" --> "*" Task : has
    Task --> TaskCategory : category
    Pet ..> Task : mark_task_complete() calls mark_complete()
    Scheduler ..> Owner : organizes tasks for
    Scheduler ..> Pet : groups conflicts per pet
